body { margin: 0; background-color: transparent; }
#buff-list, #_BuffList, #_DeBuffList { position: absolute; pointer-events: none; }
.BuffIcon, .deBuffIcon { position: absolute; padding: 0; margin: 0; pointer-events: auto; }
.buff-image, .buff-edge { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
