    <body>
        <div id="main-frame" class="main-frame">
        <div id="main-hp-background" class="marble-background hp-background"/>
        <div id="main-hp-track"><div id="main-hp-clip" class="gauge-clip marble-clip"><div id="main-hp" class="marble hp"/></div></div>
        <div id="main-mp-background" class="marble-background mp-background"/>
        <div id="main-mp-track"><div id="main-mp-clip" class="gauge-clip marble-clip"><div id="main-mp" class="marble mp"/></div></div>
        <div id="main-shell" class="main-shell"><i class="Bitmap272"/><i class="Bitmap267"/><i class="Bitmap271"/><i class="Bitmap268"/><i class="Bitmap270"/><i class="Bitmap266"/><i class="Bitmap269"/><i class="Bitmap273"/></div>
        <div id="main-sd-clip" class="gauge-clip"><div id="main-sd" class="rod sd"/></div>
        <div id="main-ag-clip" class="gauge-clip"><div id="main-ag" class="rod ag"/></div>
        <div id="main-exp-clip" class="gauge-clip"><div id="main-exp" class="experience normal"/></div>
        <div id="main-exp-frame" class="exp-frame"/>
        <div id="main-hp-text" class="main-text marble-text"/>
        <div id="main-mp-text" class="main-text marble-text"/>
        <div id="main-sd-text" class="main-text rod-text"/>
        <div id="main-ag-text" class="main-text rod-text"/>
        <div id="main-exp-current" class="main-text exp-current"/>
        <div id="main-exp-slash" class="main-text exp-slash">/</div>
        <div id="main-exp-next" class="main-text exp-next"/>
        <div id="main-exp-page" class="main-text exp-page"/>
        <div id="main-skill-page-labels" class="skill-page-labels page-one"><i class="Bitmap134"/><i class="Bitmap135"/><i class="Bitmap136"/><i class="Bitmap137"/><i class="Bitmap138"/><i class="Bitmap141"/><i class="Bitmap142"/><i class="Bitmap143"/><i class="Bitmap144"/><i class="Bitmap145"/></div>
        <div id="main-skill-page-toggle" class="mu-button skill-page-toggle to-second"><i class="arrow"/></div>
        <div id="main-current-selection" class="skill-selection current"/>
        <div id="main-hot-selection" class="skill-selection hot"/>
        <div id="main-button-shop" class="mu-button main-button shop MuButton_mainFrame01"/>
        <div id="main-button-character" class="mu-button main-button character MuButton_mainFrame02"/>
        <div id="main-button-inventory" class="mu-button main-button inventory DropdownMenu_Frame03"/>
        <div id="main-button-quest" class="mu-button main-button quest MuButton_mainFrame04"/>
        <div id="main-button-community" class="mu-button main-button community DropdownMenu_Frame05"/>
        <div id="main-button-system" class="mu-button main-button system DropdownMenu_Frame06"/>
    </div>
