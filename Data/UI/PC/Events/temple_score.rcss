body { width: 100%; height: 100%; margin: 0; background-color: transparent; font-family: Arial; }
.node, .label, .art, .state, .digit { position: absolute; }
.label, .art, .state, .digit { pointer-events: none; }
.label { white-space: nowrap; }
.state { left: 0; top: 0; width: 100%; height: 100%; }
body { display: flex; align-items: center; justify-content: center; pointer-events: none; }
#panel { position: relative; flex-shrink: 0; }
.number .digit { display: none; left: 0; top: 0; width: 100%; height: 100%; }
.number.frame-1 .digit-0 { display: block; }
.number.frame-2 .digit-1 { display: block; }
.number.frame-3 .digit-2 { display: block; }
.number.frame-4 .digit-3 { display: block; }
.number.frame-5 .digit-4 { display: block; }
.number.frame-6 .digit-5 { display: block; }
.number.frame-7 .digit-6 { display: block; }
.number.frame-8 .digit-7 { display: block; }
.number.frame-9 .digit-8 { display: block; }
.number.frame-10 .digit-9 { display: block; }
