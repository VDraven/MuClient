body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
    font-size: 14px;
    color: #ddddda;
}

#message-box {
    position: absolute;
    width: 352px;
    height: 210px;
}

#message-bottom {
    pointer-events: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#message-bottom-divider {
    display: none;
    position: absolute;
    pointer-events: none;
}

#message-title {
    display: none;
    position: absolute;
}

#message-divider {
    position: absolute;
    left: 13px;
    top: 47px;
    width: 326px;
}

#message {
    position: absolute;
    left: 24px;
    top: 72px;
    width: 304px;
    line-height: 20px;
    text-align: center;
    white-space: normal;
}

#message-content {
    width: 100%;
}

#message-content .message-line {
    display: block;
    min-height: 20px;
}

#message-input {
    position: absolute;
    left: 66px;
    top: 119px;
    width: 220px;
    height: 23px;
    line-height: 14px;
}

#message-bottom #ok-button,
#message-bottom #cancel-button {
    pointer-events: auto;
    top: 164px;
    width: 70px;
    height: 30px;
    line-height: 30px;
}

/* Exact Caution.gfx mcCaution units; RmlDocumentHost owns display scaling. */
#message-box.s16-caution {
    width: 308px;
    height: 190px;
}

#message-box.s16-caution #message-title {
    left: 73px;
    top: 17px;
    width: 163px;
    line-height: 14px;
    font-size: 12px;
    text-align: center;
    color: #ffc000;
}

#message-box.s16-caution #message-divider {
    left: 7px;
    top: 34px;
    width: 293px;
    height: 9px;
}

#message-box.s16-caution #message {
    left: 26px;
    top: 45px;
    width: 251px;
    height: 84px;
    line-height: 14px;
    font-size: 12px;
    color: #ababab;
}

#message-box.s16-caution #message-content .message-line {
    min-height: 14px;
}

#message-box.s16-caution #message-input {
    left: 60px;
    top: 80px;
    width: 188px;
    height: 17px;
    line-height: 14px;
    font-size: 12px;
}

#message-box.s16-caution #message-bottom-divider {
    display: block;
}

#message-box.s16-caution #ok-button,
#message-box.s16-caution #cancel-button {
    top: 10px;
    width: 75px;
    height: 35px;
    line-height: 35px;
    font-size: 12px;
}

#message-box #ok-button, #message-box #cancel-button { left: 141px; }
#message-box.two-buttons #ok-button { left: 96px; }
#message-box.two-buttons #cancel-button { left: 186px; }
#message-box.message-only #message { top: 92px; }
#message-box.s16-caution #ok-button, #message-box.s16-caution #cancel-button { left: 109px; }
#message-box.s16-caution.two-buttons #ok-button { left: 69px; }
#message-box.s16-caution.two-buttons #cancel-button { left: 149px; }
#message-box.s16-caution.message-only #message { top: 45px; }
