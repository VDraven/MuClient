body { width: 100%; height: 100%; margin: 0; background-color: transparent; font-family: Arial; }
#panel, #panel div, #panel label, #panel span, #panel input, .art > i, .button-state, .button-state > i { position: absolute; }
.art, .art > i, .label, .button-state, .button-state > i { pointer-events: none; }
.button-state { left: 0; top: 0; width: 100%; height: 100%; }
.text-area { overflow-x: hidden; overflow-y: auto; white-space: pre-wrap; }
.label { position: absolute; white-space: nowrap; }
#panel .drag { cursor: move; drag: drag; pointer-events: auto; }

#cbEnterCheck-input { margin: 0; padding: 0; border-width: 0; }
#cbEnterCheck, #opZen { pointer-events: auto; }
