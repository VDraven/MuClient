body { width: 100%; height: 100%; margin: 0; overflow: hidden; font-family: Arial; }
#panel, #panel div, #panel span, #panel i { position: absolute; box-sizing: border-box; }
#panel .group { left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
#panel .group.mu-hidden { display: none; }
#panel .art, #panel .label, #panel i, #panel .button-state { pointer-events: none; }
#panel .label { overflow: hidden; white-space: nowrap; }
#panel .mu-button, #panel .mu-slot, #panel .mu-overflow-label { pointer-events: auto; }
#panel .drag { cursor: move; drag: drag; pointer-events: auto; }
#panel .button-state { left: 0; top: 0; width: 100%; height: 100%; display: none; }
#panel .MUTextArea { white-space: pre-wrap; overflow-x: hidden; overflow-y: auto; pointer-events: auto; }
#panel .MUTextArea scrollbarvertical { width: 0; }
#panel .mu-scrollbar, #panel .mu-scrollbar div { pointer-events: auto; }
#panel .quest-row { display: block; position: relative; width: 100%; white-space: normal; pointer-events: auto; }
#panel .quest-heading { color: #b3e64d; font-weight: bold; }
#panel .quest-normal { color: #dfbf67; }
#panel .quest-missing { color: #ff1e1e; }
#panel .quest-random { color: #6767df; }
#taConditions, #taReward { overflow-x: hidden; overflow-y: auto; }
#taConditions scrollbarvertical, #taReward scrollbarvertical { width: 0; }
.quest_journal #panel #btnQuestOpen { left: 58px; }
.quest_journal #panel #btnQuestGiveUp { left: 175px; }
#panel .mu-list { pointer-events: auto; overflow: hidden; }
.ListItemRenderer, .ListItemRenderer span { position: absolute; box-sizing: border-box; }
.ListItemRenderer span { overflow: hidden; white-space: nowrap; pointer-events: auto; }
#quest-row-template { display: none; }
#taConditionsValue scrollbarvertical, #taRewardsValue scrollbarvertical, #taQuestMent scrollbarvertical { width: 0; }
#panel .requirement-missing { color: #ff1e1e; }
#panel .requirement-complete { color: #dfbf67; }
