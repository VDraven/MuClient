body { margin: 0; width: 100%; height: 100%; overflow: hidden; font-family: Arial; }
.login-panel, .login-panel div, .login-panel span, .login-panel input { position: absolute; box-sizing: border-box; }
.login-art, .login-art i, #title, #server-name, .label, .login-button-label { pointer-events: none; }
#title, #server-name, .label, .login-button-label { white-space: nowrap; overflow: hidden; }
.login-input { padding: 0; border-width: 0; background-color: transparent; }
