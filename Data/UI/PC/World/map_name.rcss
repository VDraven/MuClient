body { width: 100%; height: 100%; margin: 0; overflow: hidden; font-family: Arial; pointer-events: none; }
#panel, #content, .label { position: absolute; pointer-events: none; }
#panel { left: 50%; top: 45.8333333333%; transform: translateX(-50%); }
.label { white-space: nowrap; }
#art-17 { opacity: 0.30078125; }
