body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
    font-size: 12px;
    pointer-events: none;
}

#player-name-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.player-label {
    position: absolute;
    width: 0;
    height: 0;
    color: #ffffff;
    pointer-events: none;
}

.normal-block {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    pointer-events: none;
}

.name-stack {
    position: absolute;
    left: -100px;
    bottom: 10px;
    width: 200px;
    text-align: center;
    font-weight: bold;
    pointer-events: none;
}

.name-text {
    display: inline-block;
    position: relative;
    white-space: nowrap;
    pointer-events: none;
}

.name-line {
    display: none;
    height: 16px;
    line-height: 16px;
    overflow: visible;
    white-space: nowrap;
    font-effect: shadow(1px 1px #000000e5);
    pointer-events: none;
}

.player-id { display: block; }

.player-id { color: #c8dcff; }
.hero .player-id { color: #c8ff00; }
.caution .player-id { color: #ff963c; }
.murderer-one .player-id { color: #ff501e; }
.murderer-two .player-id { color: #ff0000; }
.game-master .player-id { color: #64fafa; }

.gens-mark {
    display: none;
    position: absolute;
    right: 100%;
    top: 50%;
    margin-right: 10px;
    margin-top: -37px;
    width: 52px;
    height: 74px;
    pointer-events: none;
}

.gens-1 { display: block;  }
.gens-2 { display: block;  }
.gens-3 { display: block;  }
.gens-4 { display: block;  }
.gens-5 { display: block;  }
.gens-6 { display: block;  }
.gens-7 { display: block;  }
.gens-8 { display: block;  }
.gens-9 { display: block;  }
.gens-10 { display: block;  }
.gens-11 { display: block;  }
.gens-12 { display: block;  }
.gens-13 { display: block;  }
.gens-14 { display: block;  }
.gens-15 { display: block;  }
.gens-16 { display: block;  }
.gens-17 { display: block;  }
.gens-18 { display: block;  }
.gens-19 { display: block;  }
.gens-20 { display: block;  }
.gens-21 { display: block;  }
.gens-22 { display: block;  }
.gens-23 { display: block;  }
.gens-24 { display: block;  }
.gens-25 { display: block;  }
.gens-26 { display: block;  }
.gens-27 { display: block;  }
.gens-28 { display: block;  }

.castle-mark {
    display: none;
    position: absolute;
    left: -19px;
    top: -70px;
    width: 39px;
    height: 38px;
    pointer-events: none;
}

.castle-1 { display: block;  }
.castle-2 { display: block;  }
.castle-3 { display: block;  }
.castle-4 { display: block;  }
.castle-5 { display: block;  }
.castle-6 { display: block;  }
.castle-7 { display: block;  }
.castle-8 { display: block;  }

.store-label { display: none; position: absolute; box-sizing: border-box; pointer-events: none; }
.store-frame { position: absolute; pointer-events: none; }
.store-open .normal-block { display: none; }
.store-open .store-label { display: block; }
.store-tag, .store-name, .store-title { position: absolute; pointer-events: none; white-space: nowrap; overflow: hidden; }
.store-tag, .store-title { font-weight: normal; }
.store-name { font-weight: bold; }

.highlighted .store-tag { color: #6c3929; }
.caution .store-tag, .caution .store-name { color: #e6b400; }
.murderer-one .store-tag, .murderer-one .store-name { color: #e66e00; }
.murderer-two .store-tag, .murderer-two .store-name { color: #f01400; }

.chat-anchor {
    display: none;
    position: absolute;
    left: -121px;
    bottom: 42px;
    width: 242px;
    text-align: center;
    pointer-events: none;
}

.has-guild .chat-anchor { bottom: 58px; }
.has-chat .chat-anchor { display: block; }

.chat-bubble {
    display: inline-block;
    max-width: 220px;
    padding: 7px 11px;
    position: relative;
    color: #ffffff;
    font-size: 12px;
    line-height: 14px;
    white-space: normal;
    pointer-events: none;
}

.chat-tail {
    position: absolute;
    left: 50%;
    margin-left: -5px;
    bottom: -10px;
    width: 10px;
    height: 10px;

    pointer-events: none;
}

/* Client guild relationship palette; C++ supplies the relationship state. */
.guild-line { color: #e6e6ff; }
.guild-friendly .guild-line { color: #c8ff00; }
.guild-hostile .guild-line { color: #ff1e00; }

.chat-frame { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; }
.chat-text { position: relative; }
