body { margin: 0; width: 100%; height: 100%; overflow: hidden; font-family: Arial; }
#panel, #panel div, #panel span, #panel i { position: absolute; box-sizing: border-box; }
#panel .group { left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
#panel .art, #panel i, #panel .label { pointer-events: none; }
#panel .mu-button, #panel .mu-item-slot { pointer-events: auto; }
#panel .label { overflow: hidden; white-space: nowrap; }
#panel .drag { pointer-events: auto; cursor: move; drag: drag; }

#panel .MUTextArea { white-space: pre-wrap; overflow: auto; pointer-events: auto; }
#panel .MUScrollingList { overflow: hidden; pointer-events: auto; z-index: 0; }
#panel #scrollList .MuListItemRenderer_001 { position: absolute; width: 100%; text-align: left; }
#panel #scrollList .socket-label { position: relative; pointer-events: none; white-space: nowrap; }
#panel .mu-scrollbar-button, #panel .mu-scrollbar-thumb { pointer-events: auto; }


/* Semantic text colors supplied by the existing mix rules. */
#panel .MUTextArea span { position: static; }
#panel .MUTextArea .ready { color: #ffff30; }
#panel .MUTextArea .missing { color: #ff3214; }
#panel .MUTextArea .partial { color: #d2e6ff; }
#panel .MUTextArea .warning { color: #ff3214; }
