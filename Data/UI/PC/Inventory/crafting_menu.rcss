body { margin: 0; width: 100%; height: 100%; overflow: hidden; font-family: Arial; display: flex; justify-content: center; align-items: center; }
#menu { position: relative; flex-shrink: 0; }
#menu div, #menu span, #menu i { position: absolute; box-sizing: border-box; }
#menu .group { left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
#menu .art, #menu i, #menu .label { pointer-events: none; }
#menu .mu-button { pointer-events: auto; }
#menu .label { overflow: hidden; white-space: pre-wrap; }
#menu .mu-button > .label { white-space: nowrap; }
#menu .mu-overflow-label { pointer-events: auto; }
#menu .MUTextArea { white-space: pre-wrap; overflow-x: hidden; overflow-y: auto; pointer-events: auto; }
/* These S9 text areas have no assigned scrollbar clip. Retain wheel scrolling. */
#menu .MUTextArea scrollbarvertical { width: 0; }
.trainer_menu #mcTrainerRecover, .trainer_recover #mcTrainerMenu { display: none; }
.elpis_menu #mcContributePoint, .elpis_menu #btnPrevious, .elpis_menu #btnNext,
.elpis_menu #btnSelPrevious, .elpis_menu #btnSelNext { display: none; }
#menu .drag { pointer-events: auto; cursor: move; drag: drag; }
#menu .mu-text-input { position: absolute; margin: 0; padding: 0; border-width: 0; background-color: transparent; decorator: none; }
