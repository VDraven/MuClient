body { margin: 0; width: 100%; height: 100%; overflow: hidden; font-family: Arial; }
#inventory, #inventory div, #inventory span, #inventory i { position: absolute; box-sizing: border-box; }
#inventory .art, #inventory i, #inventory .label { pointer-events: none; }
#inventory .mu-button, #inventory .mu-item-slot { pointer-events: auto; }
#inventory .label { overflow: hidden; white-space: nowrap; }
#inventory .drag { pointer-events: auto; cursor: move; drag: drag; }
#slot_pentagram { pointer-events: none; }

#inventory .mu-overflow-label { pointer-events: auto; }
