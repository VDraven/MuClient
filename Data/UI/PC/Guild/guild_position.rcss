body { width: 100%; height: 100%; margin: 0; overflow: hidden; font-family: Arial; }
#menu, #menu div, #menu span, #menu i { position: absolute; box-sizing: border-box; }
#menu .group { left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
#menu .group.mu-hidden { display: none; }
#menu .art, #menu .label, #menu i, #menu .button-state { pointer-events: none; }
#menu .label { overflow: hidden; white-space: nowrap; }
#menu .mu-button, #menu .mu-overflow-label, #menu .mu-text-input { pointer-events: auto; }
#menu .drag { cursor: move; drag: drag; pointer-events: auto; }
#menu .button-state { left: 0; top: 0; width: 100%; height: 100%; display: none; }
#menu .MUTextArea { white-space: pre-wrap; overflow-x: hidden; overflow-y: auto; pointer-events: auto; }
#menu .MUTextArea scrollbarvertical { width: 0; }
#menu .mu-scrollbar, #menu .mu-scrollbar div { pointer-events: auto; }
#menu .mu-palette { pointer-events: none; }
#menu .mu-palette-cell { pointer-events: auto; }
#menu .mu-palette.read-only .mu-palette-cell { pointer-events: none; }
#menu .mu-palette.read-only .palette-color-0 { decorator: none; }
#menu .mu-text-input { margin: 0; padding: 0; border-width: 0; background-color: transparent; decorator: none; }

body { display: flex; align-items: center; justify-content: center; }
#menu { position: relative; }
